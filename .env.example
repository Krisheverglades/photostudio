# ── Studio identity ──────────────────────────────────────────────
STUDIO_NAME="Your Studio Name"
STUDIO_TAGLINE="Portraits, weddings, and stories worth keeping"
STUDIO_EMAIL="you@yourstudio.com"
STUDIO_PHONE=""
BASE_URL="http://localhost:8000"          # becomes your real domain in production
# Booking slots use the visitor's local timezone and retain its UTC offset.

# ── Outbound email (for the client access-key emails) ───────────
# Any SMTP provider works: Gmail app password, SendGrid, Mailgun, Amazon SES...
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Your Studio Name"

# ── Google Calendar (for the booking calendar) ───────────────────
# Create these in Google Cloud Console → APIs & Services → Credentials
# (OAuth client type: "Desktop app" is easiest for a one-person studio)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALENDAR_ID="primary"              # or a dedicated calendar's ID

# ── Storage ───────────────────────────────────────────────────────
# Local folder storage works out of the box. Swap in S3/Azure Blob later
# by replacing the save/read calls in app/pipeline.py and app/main.py.
STORAGE_ROOT="./app/processed"

# ── App security ──────────────────────────────────────────────────
SECRET_KEY="change-me-to-a-long-random-string"
ADMIN_PASSWORD="change-me"
